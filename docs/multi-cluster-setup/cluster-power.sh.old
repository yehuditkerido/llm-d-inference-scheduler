#!/bin/bash
# Cluster Power Management Script
# Stop/Start OpenShift clusters to save costs

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

CLUSTERS=(
    "aigrid-hub:us-east-1"
    "aigrid-tenant1:us-east-2"
    "aigrid-tenant2:us-west-2"
)

stop_cluster() {
    local cluster_name=$1
    local region=$2
    
    echo -e "${YELLOW}Stopping cluster: $cluster_name in $region${NC}"
    
    # Use kubernetes.io/cluster/<name>=owned tag - unique per OpenShift installation
    instance_ids=$(aws ec2 describe-instances \
        --filters "Name=tag:kubernetes.io/cluster/${cluster_name},Values=owned" \
                  "Name=instance-state-name,Values=running" \
        --query 'Reservations[].Instances[].InstanceId' \
        --output text \
        --region "$region" 2>/dev/null)
    
    if [[ -z "$instance_ids" ]]; then
        echo "  No running instances found for $cluster_name"
        return
    fi
    
    count=$(echo "$instance_ids" | wc -w)
    echo "  Stopping $count instances..."
    aws ec2 stop-instances --instance-ids $instance_ids --region "$region" > /dev/null
    echo -e "${GREEN}  Stop initiated for $cluster_name ($count instances)${NC}"
}

start_cluster() {
    local cluster_name=$1
    local region=$2
    
    echo -e "${YELLOW}Starting cluster: $cluster_name in $region${NC}"
    
    # Use kubernetes.io/cluster/<name>=owned tag - unique per OpenShift installation
    instance_ids=$(aws ec2 describe-instances \
        --filters "Name=tag:kubernetes.io/cluster/${cluster_name},Values=owned" \
                  "Name=instance-state-name,Values=stopped" \
        --query 'Reservations[].Instances[].InstanceId' \
        --output text \
        --region "$region" 2>/dev/null)
    
    if [[ -z "$instance_ids" ]]; then
        echo "  No stopped instances found for $cluster_name"
        return
    fi
    
    count=$(echo "$instance_ids" | wc -w)
    echo "  Starting $count instances..."
    aws ec2 start-instances --instance-ids $instance_ids --region "$region" > /dev/null
    echo -e "${GREEN}  Start initiated for $cluster_name ($count instances)${NC}"
}

status_cluster() {
    local cluster_name=$1
    local region=$2
    
    echo -e "${YELLOW}$cluster_name ($region):${NC}"
    
    # Use kubernetes.io/cluster/<name>=owned tag - unique per OpenShift installation
    aws ec2 describe-instances \
        --filters "Name=tag:kubernetes.io/cluster/${cluster_name},Values=owned" \
        --query 'Reservations[].Instances[].[InstanceId,InstanceType,State.Name,Tags[?Key==`Name`].Value|[0]]' \
        --output table \
        --region "$region" 2>/dev/null || echo "  No instances found"
    echo ""
}

stop_all() {
    echo -e "${RED}Stopping ALL clusters...${NC}"
    echo ""
    for cluster_info in "${CLUSTERS[@]}"; do
        IFS=':' read -r name region <<< "$cluster_info"
        stop_cluster "$name" "$region"
    done
    echo ""
    echo -e "${GREEN}All clusters stop initiated. Wait 1-2 minutes for full stop.${NC}"
    echo "Run '$0 status' to check status."
}

start_all() {
    echo -e "${GREEN}Starting ALL clusters...${NC}"
    echo ""
    for cluster_info in "${CLUSTERS[@]}"; do
        IFS=':' read -r name region <<< "$cluster_info"
        start_cluster "$name" "$region"
    done
    echo ""
    echo -e "${GREEN}All clusters start initiated. Wait 5-10 minutes for full startup.${NC}"
    echo "Clusters may take additional time to become fully ready."
    echo "Run '$0 status' to check status."
}

status_all() {
    echo "Cluster Status"
    echo "=============="
    echo ""
    for cluster_info in "${CLUSTERS[@]}"; do
        IFS=':' read -r name region <<< "$cluster_info"
        status_cluster "$name" "$region"
    done
}

usage() {
    echo "Usage: $0 {stop|start|status|stop-all|start-all}"
    echo ""
    echo "Commands:"
    echo "  stop <cluster>    Stop a specific cluster (hub, spoke1, spoke2)"
    echo "  start <cluster>   Start a specific cluster"
    echo "  status            Show status of all clusters"
    echo "  stop-all          Stop ALL clusters (for overnight/weekend)"
    echo "  start-all         Start ALL clusters"
    echo ""
    echo "Examples:"
    echo "  $0 stop-all       # End of day - stop everything"
    echo "  $0 start-all      # Start of day - start everything"
    echo "  $0 stop hub       # Stop just the hub"
    echo "  $0 status         # Check what's running"
}

case "$1" in
    stop)
        case "$2" in
            hub)     stop_cluster "aigrid-hub" "us-east-1" ;;
            spoke1)  stop_cluster "aigrid-tenant1" "us-east-2" ;;
            spoke2)  stop_cluster "aigrid-tenant2" "us-west-2" ;;
            *)       echo "Unknown cluster: $2. Use: hub, spoke1, spoke2"; exit 1 ;;
        esac
        ;;
    start)
        case "$2" in
            hub)     start_cluster "aigrid-hub" "us-east-1" ;;
            spoke1)  start_cluster "aigrid-tenant1" "us-east-2" ;;
            spoke2)  start_cluster "aigrid-tenant2" "us-west-2" ;;
            *)       echo "Unknown cluster: $2. Use: hub, spoke1, spoke2"; exit 1 ;;
        esac
        ;;
    status)
        status_all
        ;;
    stop-all)
        stop_all
        ;;
    start-all)
        start_all
        ;;
    *)
        usage
        exit 1
        ;;
esac
